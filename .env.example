# ========================================
# Debrief Environment Variables
# ========================================
# Copy this file to .env.local and fill in your values.
#
# Debrief is a single Next.js app: the idea-validation platform and the
# Growth Lab simulation (/game) ship together and share one Supabase
# project. There are no cross-app URLs to configure.

# ----------------------------------------
# Supabase (required)
# ----------------------------------------
# Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# Service-role key. Bypasses RLS — server-side only, never expose to the client.
# Required for admin management and other operations that must bypass RLS.
SUPABASE_SECRET_KEY=your_supabase_service_role_key_here

# ----------------------------------------
# App URL (required in production)
# ----------------------------------------
# Used to build OAuth callback and email links. Defaults to
# http://localhost:3000, so it MUST be set to the real origin when deployed
# or invite and welcome emails will point at localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------
# Email (optional — team invitations and welcome mail)
# ----------------------------------------
# Without these, invitations are created but no mail is sent.
# EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
# EMAIL_HOST_USER=your_smtp_username
# EMAIL_HOST_PASSWORD=your_smtp_password
# EMAIL_PORT=587
# FROM_MAIL=noreply@yourdomain.com

# ----------------------------------------
# Redis (optional — distributed rate limiting)
# ----------------------------------------
# Falls back to in-memory rate limiting when unset, which does not hold
# across multiple instances.
# REDIS_URL=redis://localhost:6379

# ========================================
# Google OAuth setup
# ========================================
# 1. Supabase Dashboard -> Authentication -> Providers -> Google -> Enable
# 2. Add your Google Client ID and Secret
#
# Google Cloud Console -> Authorized redirect URIs.
# Google only ever redirects back to Supabase, so this is the ONLY entry:
#   https://YOUR_PROJECT_ID.supabase.co/auth/v1/callback
#
# Supabase Dashboard -> Authentication -> URL Configuration -> Redirect URLs.
# This is the allowlist for the `redirectTo` the app asks for. Miss an entry
# and Supabase silently ignores redirectTo and sends the user to the Site URL
# instead, with ?code= still in the URL — /auth/callback never runs, the code
# is never exchanged, and the user lands back signed out:
#   http://localhost:3000/auth/callback          (development)
#   https://your-domain.com/auth/callback        (production)
#
# Supabase Dashboard -> Authentication -> URL Configuration -> Site URL:
#   https://your-domain.com
